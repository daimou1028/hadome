#!/bin/sh
set -e
if [ -n "$SKIP_CHECK" ]; then
  echo "[pre-commit] SKIP_CHECK が立っているので自己検査を飛ばします" >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
if ! node -e 'process.exit(require("./package.json").scripts["check:fast"] ? 0 : 1)' 2>/dev/null; then
  exit 0
fi
echo "[pre-commit] npm run check:fast（19 秒ほど）" >&2
OUT=$(npm run check:fast 2>&1); RC=$?
if [ "$RC" -ne 0 ]; then
  echo "$OUT" | tail -30 >&2
  echo "[pre-commit] 自己検査が落ちました（RC=$RC）。直してから commit してください。どうしても通すなら SKIP_CHECK=1" >&2
  exit 1
fi
exit 0
